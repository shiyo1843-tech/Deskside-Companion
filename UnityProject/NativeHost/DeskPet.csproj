<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>桌边伙伴</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Brand/DeskPet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Brand/DeskPet.ico"/>
    <EmbeddedResource Include="Icons/*.png" LogicalName="WheelIcons.%(Filename).png"/>
    <EmbeddedResource Include="StarWheel/*.png" LogicalName="StarWheel.%(Filename).png"/>
    <EmbeddedResource Include="../Assets/DeskPet/Editor/DeskPetExporter.cs;../ExternalTools/VRChat/DeskPetVRChat.cs;../ExternalTools/VRChat/DeskPetPackageBuild.cs" LogicalName="PackageTools.%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
